<?xml version="1.0"?>
<robot name="mini_mec_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- drive: "diff" (default, smoke-test only) or "holonomic".
       CCA-NMPC control is holonomic Mecanum u=[vx, vy, omega]; the controller
       publishes cmd_vel.linear.y. libgazebo_ros_diff_drive.so IGNORES linear.y,
       so control-accuracy claims involving lateral motion require drive:=holonomic
       (planar-move plugin actuates x, y and yaw). See docs/09_roadmap.md Section 3. -->
  <xacro:arg name="drive" default="diff" />

  <!-- Lightweight simulation model. The vendor CAD URDF uses STL collision
       meshes, which makes Gazebo's contact solver unusably slow. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0" />
      <mass value="0.68" />
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.006" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0" />
      <geometry><box size="0.22 0.16 0.10" /></geometry>
      <material name="blue"><color rgba="0.15 0.35 0.85 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0" />
      <geometry><box size="0.22 0.16 0.10" /></geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <inertial>
        <mass value="0.057" />
        <inertia ixx="2.1e-5" ixy="0" ixz="0" iyy="3.4e-5" iyz="0" izz="2.1e-5" />
      </inertial>
      <visual>
        <origin rpy="1.570796 0 0" />
        <geometry><cylinder radius="0.0363" length="0.025" /></geometry>
        <material name="dark"><color rgba="0.12 0.12 0.12 1" /></material>
      </visual>
      <collision>
        <origin rpy="1.570796 0 0" />
        <geometry><cylinder radius="0.0363" length="0.025" /></geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <origin xyz="${x} ${y} 0.0363" />
      <parent link="base_link" />
      <child link="${name}_wheel_link" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <xacro:wheel name="lf" x="0.079" y="0.099" />
  <xacro:wheel name="lb" x="-0.079" y="0.099" />
  <xacro:wheel name="rf" x="0.079" y="-0.099" />
  <xacro:wheel name="rb" x="-0.079" y="-0.099" />

  <link name="laser"><visual><geometry><cylinder radius="0.025" length="0.03" /></geometry></visual></link>
  <joint name="laser_joint" type="fixed"><origin xyz="0.03 0 0.14"/><parent link="base_link"/><child link="laser"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.035 0.05 0.025" /></geometry></visual></link>
  <joint name="camera_joint" type="fixed"><origin xyz="0.105 0 0.21" rpy="0 -0.34906585 0"/><parent link="base_link"/><child link="camera_link"/></joint>

  <!-- ROS optical-frame convention (docs/config camera_optical_frame):
       body camera_link (x-forward) -> optical (x-right, y-down, z-forward).
       Standard rotation rpy="-pi/2 0 -pi/2". -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
  </joint>

  <!-- Gazebo plugins for simulation -->

  <!-- Differential-drive approximation: SMOKE TEST ONLY.
       libgazebo_ros_diff_drive.so ignores cmd_vel.linear.y, so this branch must
       NOT be used for Mecanum lateral-motion validation. Use drive:=holonomic
       for any control-accuracy claim. -->
  <xacro:if value="${'$(arg drive)' == 'diff'}">
    <gazebo>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <update_rate>50</update_rate>
        <left_joint>lf_wheel_joint</left_joint>
        <right_joint>rf_wheel_joint</right_joint>
        <wheel_separation>0.197</wheel_separation>
        <wheel_diameter>0.0726</wheel_diameter>
        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>1.0</max_wheel_acceleration>
        <command_topic>cmd_vel</command_topic>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Holonomic planar-move plugin: actuates cmd_vel.linear.x, linear.y and
       angular.z, matching the Mecanum control input u=[vx, vy, omega]. This is
       the branch valid for CCA-NMPC lateral-motion control results. -->
  <xacro:if value="${'$(arg drive)' == 'holonomic'}">
    <gazebo>
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <update_rate>50</update_rate>
        <command_topic>cmd_vel</command_topic>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.01</covariance_yaw>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Lidar sensor plugin -->
  <gazebo reference="laser">
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Camera plugin -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <update_rate>30.0</update_rate>
      <camera name="camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>10</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/color/image_raw</remapping>
          <remapping>camera_info:=/camera/color/camera_info</remapping>
        </ros>
        <frame_name>camera_color_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Depth camera plugin (simulating Astra depth) -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="depth_sensor">
      <update_rate>10.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="depth_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>depth/image_raw:=/camera/aligned_depth_to_color/image_raw</remapping>
          <remapping>depth/camera_info:=/camera/depth/camera_info</remapping>
        </ros>
        <frame_name>camera_color_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU plugin -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <remapping>~/out:=imu/data_raw</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>gyro_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Material/friction properties for wheels -->
  <gazebo reference="lf_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="lb_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="rf_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="rb_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
