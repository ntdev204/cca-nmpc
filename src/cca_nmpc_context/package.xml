<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cca_nmpc_context</name>
  <version>0.1.0</version>
  <description>Continuous context estimation for CCA-NMPC (per-human phi_j, EMA, dwell-time gate, aggregation)</description>
  <maintainer email="dev@example.com">CCA-NMPC Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>cca_nmpc_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
